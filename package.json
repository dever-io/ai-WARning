{
  "name": "ai-warning",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "API_PORT=8787 node --watch --disable-warning=ExperimentalWarning server/src/index.ts",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "start": "node --disable-warning=ExperimentalWarning server/src/index.ts",
    "reset": "node --disable-warning=ExperimentalWarning server/src/reset-cli.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "hono": "^4.9.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.0"
  }
}
